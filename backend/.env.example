# ============================================================
# نمونه تنظیمات محیطی بک‌اند ارزان‌کالا
# این فایل را به .env کپی کنید و مقادیر را پر کنید
# ============================================================

# پورت سرور (روی Render خودکار تنظیم می‌شود)
PORT=3000

# ------------------------------------------------------------
# 🗄️ اتصال به MySQL — یکی از دو روش زیر
# ------------------------------------------------------------

# روش ۱ (پیشنهادی): یک آدرس کامل
# از Railway → سرویس MySQL → Variables → MYSQL_PUBLIC_URL کپی کنید
MYSQL_URL=mysql://root:PASSWORD@shinkansen.proxy.rlwy.net:12345/railway

# روش ۲: متغیرهای جداگانه (اگر MYSQL_URL خالی باشد استفاده می‌شود)
# MYSQLHOST=127.0.0.1
# MYSQLPORT=3306
# MYSQLUSER=root
# MYSQLPASSWORD=
# MYSQLDATABASE=arzankala

# اگر دیتابیس شما اتصال SSL لازم دارد (مثل Aiven یا PlanetScale)
# MYSQL_SSL=true

# ------------------------------------------------------------
# 🔐 امنیت
# ------------------------------------------------------------
# کلید امضای توکن — حتماً یک رشته تصادفی و طولانی بگذارید
JWT_SECRET=change_this_to_a_long_random_secret

# کاربر مدیر که در اولین اجرا ساخته می‌شود
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# ------------------------------------------------------------
# ⚙️ اختیاری
# ------------------------------------------------------------
# وارد کردن خودکار داده‌های اولیه وقتی دیتابیس خالی است
AUTO_SEED=true

# تعداد تلاش مجدد برای اتصال به دیتابیس
DB_MAX_RETRIES=8
DB_RETRY_DELAY_MS=2000

# محدود کردن دامنه‌های مجاز (خالی = همه مجاز)
# ALLOWED_ORIGINS=https://username.github.io,https://arzankala.onrender.com

# کلید تحلیل نظرات با هوش مصنوعی (اختیاری)
DEEPSEEK_API_KEY=
